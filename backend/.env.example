# Google Gemini API key (or use Application Default Credentials — leave blank for ADC)
GOOGLE_API_KEY=

# NotebookLM notebook ID from the URL (e.g. abc123def456)
NOTEBOOK_ID=

# Absolute path to the notebooklm cookie file inside the container / on your machine
NLM_COOKIE_PATH=/mnt/data/nlm_cookies.json

# Optional MCP server launch override. By default the backend uses
# `notebooklm-mcp` when installed, otherwise `uvx --from notebooklm-mcp-cli notebooklm-mcp`.
# NLM_MCP_COMMAND=uvx
# NLM_MCP_ARGS=--from notebooklm-mcp-cli notebooklm-mcp

# Timeout, in seconds, for NotebookLM notebook_query calls
NOTEBOOKLM_QUERY_TIMEOUT=120

# Absolute path to the SQLite database file
DB_PATH=/mnt/data/app.db

# Allowed CORS origin — set to your Cloudflare Pages URL in production
# Use * for local dev / initial curl testing
CORS_ORIGIN=http://localhost:5173

# Gemini model IDs — swap Pro <-> Flash without code changes
EXTRACTOR_MODEL=gemini-2.0-flash
VERIFIER_MODEL=gemini-2.0-flash
